# Nginx configuration for dipole.musicsian.com
# Django + Gunicorn application
#
# Install: sudo cp nginx.conf /etc/nginx/conf.d/dipole.musicsian.com.conf
# Then run: sudo certbot --nginx -d dipole.musicsian.com

server {
    listen 80;
    listen [::]:80;
    server_name dipole.musicsian.com;

    # Logs
    access_log /var/log/nginx/dipole.access.log;
    error_log  /var/log/nginx/dipole.error.log;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Static files - Django collects to 'staticfiles' directory
    location /static/ {
        alias /var/www/dipole.musicsian.com/current/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Media files (user uploads)
    location /media/ {
        alias /var/www/dipole.musicsian.com/current/media/;
        expires 7d;
        add_header Cache-Control "public";
    }

    # Proxy to Django/Gunicorn
    location / {
        proxy_pass http://unix:/run/dipole/gunicorn.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts for long-running requests
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Block hidden files
    location ~ /\. {
        deny all;
        return 404;
    }

    client_max_body_size 10M;
}
